# Milestone 2 - LLM provider configuration
#
# Default provider is Google Gemini (free tier available, NO Anthropic key
# required). Get a free key at https://aistudio.google.com/apikey and set:
GEMINI_API_KEY=your-gemini-key-here

# If you don't set any key at all, the app still works end-to-end: it
# automatically falls back to a built-in offline rule-based engine
# (local_extraction.py) so the Milestone 2 pipeline never hard-fails.

# Optional alternate providers (only needed if you change LLMConfig.provider
# in llm_service.py to "anthropic" or "openai"):
# ANTHROPIC_API_KEY=your-anthropic-key-here
# OPENAI_API_KEY=your-openai-key-here

# =============================================================================
# Milestone 3 - Embedding Generation (Task 2) & Vector Database (Task 3)
# =============================================================================

# Embeddings reuse the keys you already have - nothing extra is needed if
# GEMINI_API_KEY (above) is set:
#   * GEMINI_API_KEY set  -> Gemini embeddings (gemini-embedding-001)
#   * else OPENAI_API_KEY -> OpenAI embeddings (text-embedding-3-small)
#   * else no key         -> built-in offline matcher (keyword-based, weaker)
# To force a choice, and/or override the model:
# EMBEDDING_PROVIDER=gemini        # gemini | openai | local
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_API_KEY=...            # optional generic key, used if the provider's own key var is empty

# If the embedding provider fails at runtime (bad key, quota, no network) the
# app falls back to the offline matcher and logs why. Run
# `python diagnose_search.py` to see exactly which provider is in use.

# Vector database (Task 3) defaults to ChromaDB, persisted locally - no
# server or key needed. VECTOR_DATABASE_URL is a local filesystem path
# (not a network URL) since ChromaDB's PersistentClient and the local
# JSON fallback both persist to disk in this project.
# VECTOR_DATABASE_URL=./chroma_db
# VECTOR_COLLECTION_NAME=meeting_intelligence

# If chromadb isn't installed, vector storage falls back automatically to
# a local JSON-based store - no configuration needed for that to happen.

# Logging verbosity for all Milestone 1-3 modules (DEBUG, INFO, WARNING, ERROR):
# LOG_LEVEL=INFO

# =============================================================================
# Milestone 4 - Deployment configuration (config.py reads all of these)
# =============================================================================

# development | production. In production the API REFUSES TO START if
# PASSWORD_PEPPER is weak, CORS_ORIGINS contains "*", or API_BASE_URL is plain http
# to a public host.
APP_ENV=development

# --- Security -----------------------------------------------------------------
# Random secret mixed into password hashes. REQUIRED in production (>=16 chars).
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later invalidates every existing password.
PASSWORD_PEPPER=
SESSION_TTL_HOURS=12
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
ALLOW_REGISTRATION=true
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8501

# --- API / dashboard ------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000     # where the Streamlit dashboard finds the API
MAX_UPLOAD_MB=500
WHISPER_MODEL=base                     # tiny | base | small | medium | large

# --- Storage (point these at a persistent volume in production) -----------------
# DATABASE_PATH=./meetings.db
# TRANSCRIPTS_DIR=./transcripts
# SAVE_TRANSCRIPT_FILES=true
# LOG_DIR=./logs
# LOG_TO_FILE=true
# SENTRY_DSN=                          # optional error monitoring (pip install sentry-sdk)

# --- Zoom (Server-to-Server OAuth app) ------------------------------------------
# Zoom Marketplace -> Develop -> Build App -> Server-to-Server OAuth.
# Scope: cloud_recording:read:list_user_recordings:admin (or recording:read:admin)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# ZOOM_USER_ID=me

# --- Google Meet (recordings live in Google Drive -> "Meet Recordings") ---------
# Google Cloud Console -> enable the Drive API -> OAuth client (Desktop app).
# Obtain a refresh token once for scope https://www.googleapis.com/auth/drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- Import behaviour ---------------------------------------------------------------
# INTEGRATION_MAX_ATTEMPTS=3           # retries for a recording that fails processing
# INTEGRATION_LOOKBACK_DAYS=7

